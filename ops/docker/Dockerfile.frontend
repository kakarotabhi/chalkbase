# syntax=docker/dockerfile:1
# Build context is the repository root:  docker build -f ops/docker/Dockerfile.frontend .
FROM node:24-alpine AS build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
# The generated contract lives outside frontend/ and tsconfig.json maps `@contracts/*` to
# `../contracts/*` — so from WORKDIR /build that resolves to /contracts. Copy it in, or every
# generated type silently degrades to an index signature and the build dies on TS4111 rather than
# on the missing import, which is why this took two days to be noticed.
COPY contracts/ /contracts/
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY ops/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist/chalkbase-web/browser /usr/share/nginx/html
EXPOSE 80
