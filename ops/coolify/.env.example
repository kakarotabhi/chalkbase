# Copy into the Coolify application environment. Never commit real values.
SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/chalkbase
SPRING_DATASOURCE_USERNAME=chalkbase
SPRING_DATASOURCE_PASSWORD=

# Trim actuator exposure in production.
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info

# SMS / WhatsApp / email providers — fill in when the communication module ships.
# CHALKBASE_SMS_PROVIDER=
# CHALKBASE_SMS_API_KEY=
