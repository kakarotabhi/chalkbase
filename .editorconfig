# Chalkbase editor defaults. Formatters (Spotless, Prettier) are the enforcement; this file just
# stops editors from fighting them before the formatter runs.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.java]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml,json,ts,html,scss,css}]
indent_size = 2

[*.sql]
indent_size = 4

[Makefile]
indent_style = tab
