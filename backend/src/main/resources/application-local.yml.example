# Copy to application-local.yml and fill in the password:
#
#     cp application-local.yml.example application-local.yml
#
# application-local.yml is gitignored. This repository is PUBLIC — never put a real password in a
# committed file. Prefer exporting CHALKBASE_DB_PASSWORD in your shell over typing it here.
#
# The project ref and region below are placeholders for the same reason. They are not secrets on
# their own, but publishing them leaves only the password between the internet and the database,
# and half a credential is worth more to an attacker than none. Both are on the project's Supabase
# dashboard, which is where anyone entitled to them already is.
spring:
  datasource:
    # Supabase pooler (Supavisor), session mode on 5432.
    #
    # The direct host db.<ref>.supabase.co resolves to IPv6 ONLY, which most machines (WSL2
    # included) cannot reach. The pooler host is dual-stack, so use it. Session mode rather than
    # transaction mode (6543) because the tenant schema is selected with SET search_path (ADR-0011).
    url: jdbc:postgresql://aws-0-<your-region>.pooler.supabase.com:5432/postgres?sslmode=require
    username: postgres.<your-project-ref>
    password: ${CHALKBASE_DB_PASSWORD:REPLACE_ME}
    hikari:
      # The free tier has a small connection budget and it is shared by everyone using this project.
      maximum-pool-size: 5
      minimum-idle: 1
      connection-timeout: 30000

  jpa:
    properties:
      hibernate:
        format_sql: true

logging:
  level:
    in.chalkbase: DEBUG
    org.hibernate.SQL: DEBUG

chalkbase:
  dev:
    # Builds one invented school the first time the application starts against an empty database, so
    # that `./mvnw spring-boot:run` opens on a school you can sign into rather than on an empty login
    # screen. See `in.chalkbase.platform.devdata.DemoSchoolSeeder`.
    #
    # What it creates: school DEMO-001 (schema `demo_school`), the current April–March academic year,
    # Nursery through Class 8 with sections A and B, sixty invented students with enrolments and roll
    # numbers, guardians deliberately shared between siblings (ADR-0020 §5), and four accounts —
    # `principal`, `classteacher`, `auditor` and `newteacher` — all with one password, which is
    # printed in a block at the end of startup. Every person in it is invented; none of it is real
    # student data and none of it ever may be (AGENTS rule 9).
    #
    # It runs ONCE. On every later start it finds DEMO-001 already registered, logs one line and does
    # nothing, so restarting twenty times does not produce twenty schools. To rebuild it, drop the
    # schema and the registry row by hand:
    #
    #     drop schema demo_school cascade;
    #     delete from public.school where code = 'DEMO-001';
    #
    # It is `local` only, three times over: the bean exists only on that profile, this property gates
    # it, and the seeder itself re-checks the active profiles at run time and refuses to start the
    # application if `prod` or `test` is among them.
    #
    # Set this to false if you would rather onboard a school yourself. Omitting it entirely is the
    # same as true — a developer whose application-local.yml predates this property still gets a
    # school to look at.
    seed-demo-school: true
