# --- Build output ---
target/
dist/
out-tsc/
/coverage/
*.tsbuildinfo

# --- Dependencies ---
node_modules/
.angular/

# --- Local environment (never commit secrets) ---
.env
.env.*
!.env.example
*.local.yml
application-local.yml
application-local.properties

# --- Tooling ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Claude Code local overrides ---
.claude/settings.local.json

# --- Generated docs/diagrams from Spring Modulith ---
backend/target/spring-modulith-docs/

# Built design canvases: ~2.7MB single-file bundles, rebuilt from the .dc.html sources.
# The negation matters — without it this also swallows the artboard sources.
docs/artifacts/*.html
!docs/artifacts/*.dc.html

# Supabase CLI scratch state — a linked-project ref, written by whichever project you last
# linked. Machine-local, not a property of the repository.
supabase/.temp/

# Playwright MCP writes a page snapshot per interaction while a screen is being driven in a
# browser. They are a byproduct of a verification session, not a fixture, and fourteen of them
# reached main before anyone noticed.
.playwright-mcp/
